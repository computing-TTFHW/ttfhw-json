    "patch": "diff --git a/csrc/ops/eagle_quant_batch_matmul_swiglu/op_host/CMakeLists.txt b/csrc/ops/eagle_quant_batch_matmul_swiglu/op_host/CMakeLists.txt\nindex 964a151..1043124 100644\n--- a/csrc/ops/eagle_quant_batch_matmul_swiglu/op_host/CMakeLists.txt\n+++ b/csrc/ops/eagle_quant_batch_matmul_swiglu/op_host/CMakeLists.txt\n@@ -36,6 +36,7 @@ foreach(qbmm_target eagle_qbmm_tiling eagle_qbmm_proto)\n         ${CMAKE_CURRENT_SOURCE_DIR}\n         ${CMAKE_CURRENT_SOURCE_DIR}/../../utils/inc\n         ${ASCEND_CANN_PACKAGE_PATH}/${CMAKE_SYSTEM_PROCESSOR}-linux/include/exe_graph\n+        ${ASCEND_CANN_PACKAGE_PATH}/${CMAKE_SYSTEM_PROCESSOR}-linux/include/op_common/op_host\n         ${ASCEND_CANN_PACKAGE_PATH}/${CMAKE_SYSTEM_PROCESSOR}-linux/pkg_inc/op_common/op_host\n         ${ASCEND_CANN_PACKAGE_PATH}/${CMAKE_SYSTEM_PROCESSOR}-linux/asc/include/tiling\n         ${ASCEND_CANN_PACKAGE_PATH}/${CMAKE_SYSTEM_PROCESSOR}-linux/pkg_inc/base\ndiff --git a/mindiesd/layers/rms_norm_indexed_scale_shift_dynamic_mx_quant.py b/mindiesd/layers/rms_norm_indexed_scale_shift_dynamic_mx_quant.py\nindex bce8035..01337b4 100644\n--- a/mindiesd/layers/rms_norm_indexed_scale_shift_dynamic_mx_quant.py\n+++ b/mindiesd/layers/rms_norm_indexed_scale_shift_dynamic_mx_quant.py\n@@ -629,14 +629,16 @@ if _HAS_TRITON:\n         scale_stride: tl.constexpr,\n         n_conds: tl.constexpr,\n     ):\n-        \"\"\"H == 1 edge path: scalar per row, no 2-D reshape/stride folding.\"\"\"\n+        \"\"\"H == 1 edge path with a masked vector for FP8 conversion.\"\"\"\n         row = (tl.program_id(0) + row_offset).to(tl.int64)\n+        lanes = tl.arange(0, 32)\n+        valid = lanes == 0\n         index = _safe_scalar_index(tl.load(indices_ptr + row), n_conds)\n-        xv = tl.load(x_ptr + row).to(tl.float32)\n-        wv = tl.load(weight_ptr).to(tl.float32)\n+        xv = tl.load(x_ptr + row + lanes, mask=valid, other=0.0).to(tl.float32)\n+        wv = tl.load(weight_ptr + lanes, mask=valid, other=0